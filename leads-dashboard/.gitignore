# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime server database — one JSON file per collection, plus a shared
# freshness marker and the retired pre-migration snapshot. Not source, lives
# only on the server; the data/ directory itself is created at runtime.
data/*.json
data/*.json.migrated

# uploaded document storage (design assets, reimbursement receipts) — real
# files on disk, referenced by storageKey from the JSON records above. Back
# up the whole data/ directory together so records and the files they
# reference are always restored as a matching pair.
data/uploads/

# cached OCR language data (tesseract.js), fetched once and reused —
# not source, safe to delete and re-fetch at any time.
data/ocr-cache/

# retired live data, automatically renamed (never deleted) before a database
# restore overwrites data/ — a safety net for undoing a bad restore by hand.
data.pre-restore-*/

# downloaded/uploaded encrypted database backups — never source, and never
# something that should end up committed to the repo by accident.
*.leadsbackup
