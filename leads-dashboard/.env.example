# Local Postfix submission target — the app hands every email off to Postfix
# running on this same machine, which is what actually relays out through the
# org's Google Workspace account. Defaults are correct for the standard
# "Postfix as a local relay" setup on the VPS and normally don't need changing.
SMTP_HOST=localhost
SMTP_PORT=25

# Must match (or be a verified Workspace "Send As" alias of) the Gmail account
# Postfix is authenticated as in /etc/postfix/sasl_passwd on the VPS, or
# Gmail's relay will reject the mail. The actual Gmail App Password is never
# set here — it lives only in Postfix's own config on the server.
ANNOUNCEMENT_FROM_EMAIL=leads@msruas.ac.in
ANNOUNCEMENT_FROM_NAME=LEADS Next Gen Centre
